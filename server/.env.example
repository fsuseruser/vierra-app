DATABASE_URL="postgresql://user:password@localhost:5432/vierra"
JWT_SECRET="replace-with-a-long-random-string"
PORT=4000
SEED_ADMIN_EMAIL="admin@vierra.ae"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Where the frontend lives, so OAuth redirects can send the browser back to it.
# Same origin as your app in production (e.g. https://vierra.up.railway.app);
# http://localhost:5173 for local dev.
FRONTEND_URL="http://localhost:5173"

# Google Calendar OAuth (optional — the "Link Google Calendar" button on the
# Admin > Team & Calendar page explains itself if these are left blank).
# Create these at https://console.cloud.google.com/apis/credentials
#  1. Create a project, enable the "Google Calendar API"
#  2. Configure the OAuth consent screen (External, add your email as a test user)
#  3. Create an OAuth Client ID, type "Web application"
#  4. Add GOOGLE_REDIRECT_URI below as an "Authorized redirect URI"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/integrations/google/callback"
